ObjC.import("AppKit");

// Runs under JXA, not Node. Read local application artwork without launching apps.
function run(argv) {
  const directory = argv[0];
  const apps = JSON.parse(argv[1]);
  const found = [];
  for (const app of apps) {
    const url = $.NSWorkspace.sharedWorkspace.URLForApplicationWithBundleIdentifier(app.bundleId);
    if (url.isNil()) continue;
    const icon = $.NSWorkspace.sharedWorkspace.iconForFile(url.path);
    icon.size = $.NSMakeSize(64, 64);
    const bitmap = $.NSBitmapImageRep.imageRepWithData(icon.TIFFRepresentation);
    const png = bitmap.representationUsingTypeProperties($.NSPNGFileType, $({}));
    if (png.isNil() || !png.writeToFileAtomically($(directory + "/" + app.id + ".png"), true)) {
      throw new Error("Could not export icon for " + app.title);
    }
    found.push(app.id);
  }
  return JSON.stringify(found);
}
